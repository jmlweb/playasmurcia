# Local development (SQLite file). If TURSO_* is set below, the app uses Turso instead.
DATABASE_URL=file:./local.db

# Production / remote (Turso). When set, overrides DATABASE_URL for both `pnpm dev` and `pnpm drizzle-kit push`.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Aemet
AEMET_API_KEY=XXX