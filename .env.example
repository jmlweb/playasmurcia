# Local development (SQLite file). If TURSO_* is set below, the app uses Turso instead.
DATABASE_URL=file:./local.db

# Production / remote (Turso). When set, overrides DATABASE_URL for both `pnpm dev` and `pnpm drizzle-kit push`.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Aemet
AEMET_API_KEY=XXX

# Mapbox public token (pk.*) for map tiles and static maps. Inlined into the client bundle at build time,
# so restrict it to the site's URLs in the Mapbox dashboard.
VITE_MAPBOX_TOKEN=pk.your-public-token

# Pictures domain (R2 bucket custom domain). Leave unset locally to serve public/pictures/ through Vite.
# VITE_PICTURES_BASE_URL=https://img.playasmurcia.com

# R2 S3 API credentials for `pnpm sync:pictures` (rclone). Create a bucket-scoped token in the R2 dashboard.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
