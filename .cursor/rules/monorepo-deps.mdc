description: 
globs: 
alwaysApply: true
---
 # Monorepo Package Dependencies

<rule>
name: monorepo_dependencies
description: Standards for managing dependencies in monorepo packages
filters:
  - type: file_extension
    pattern: "\\.json$"
  - type: file_name
    pattern: "^package\\.json$"

actions:
  - type: suggest
    message: |
      When managing dependencies in monorepo packages:

      1. Shared Configurations:
         ```json
         {
           "devDependencies": {
             "@repo/eslint-config": "workspace:*",
             "@repo/typescript-config": "workspace:*"
           }
         }
         ```

      2. Required Scripts:
         ```json
         {
           "scripts": {
             "build": "tsc",
             "dev": "SWCRC=true node -r @swc-node/register src/index.ts",
             "lint": "eslint src --ext .ts",
             "check-types": "tsc --noEmit",
             "format": "prettier --write \"src/**/*.{ts,json,md}\""
           }
         }
         ```

      3. Best Practices:
         - Always include check-types script for TypeScript projects
         - Use workspace:* for internal package dependencies
         - Keep shared configs in devDependencies
         - Maintain consistent script names across packages
         - Don't duplicate shared configurations

      4. Package Structure:
         ```
         PROJECT_ROOT/
         ├── packages/
         │   ├── eslint-config/
         │   └── typescript-config/
         └── apps/
             └── your-app/
                 └── package.json
         ```

examples:
  - input: |
      {
        "devDependencies": {
          "eslint": "^8.57.0",
          "typescript": "^5.3.3"
        }
      }
    output: |
      {
        "devDependencies": {
          "@repo/eslint-config": "workspace:*",
          "@repo/typescript-config": "workspace:*",
          "eslint": "^8.57.0",
          "typescript": "^5.3.3"
        }
      }

  - input: |
      {
        "scripts": {
          "build": "tsc",
          "dev": "node src/index.ts"
        }
      }
    output: |
      {
        "scripts": {
          "build": "tsc",
          "dev": "SWCRC=true node -r @swc-node/register src/index.ts",
          "lint": "eslint src --ext .ts",
          "check-types": "tsc --noEmit",
          "format": "prettier --write \"src/**/*.{ts,json,md}\""
        }
      }

metadata:
  priority: high
  version: 1.0
</rule>