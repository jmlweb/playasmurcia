# Project Organization Standards

<rule>
name: project-organization
description: Standards for project structure and organization across the monorepo
filters:
  - type: directory_structure
    pattern: "^(apps|packages)/"

actions:
  - type: suggest
    message: |
      Project Organization Guidelines:

      1. Directory Structure:
         ```
         PROJECT_ROOT/
         ├── apps/
         │   ├── crawler/           # CLI Data Processing Tool
         │   │   ├── source-data/   # Input JSON data
         │   │   ├── results/       # Processed output
         │   │   │   └── pictures/  # Downloaded beach images
         │   │   └── src/          # Source code
         │   └── web/              # Public Beach Catalog
         │       └── app/          # Next.js application
         └── packages/             # Shared internal packages
             ├── eslint-config/    # Shared ESLint configuration
             └── typescript-config/ # Shared TypeScript configuration
         ```

      2. Apps Description:
         - crawler:
           - Purpose: Data processing CLI tool
           - Input: Reads from source-data/beaches.json
           - Processing: Normalizes and augments beach data
           - Image Handling: Downloads and validates beach images
           - Output: Processed data and validated images in results/
         
         - web:
           - Purpose: Public beach catalog interface
           - Features: Search and browse processed beach data
           - Data Source: Uses processed data from crawler
           - Type: Next.js application

      3. Shared Code Guidelines:
         - Move shared logic between apps to packages/
         - Create new packages when identifying reusable code
         - Common candidates for shared packages:
           - Data types and interfaces
           - Data processing utilities
           - Image handling utilities
           - Search functionality
           - Common UI components

      4. Package Creation Best Practices:
         - Use consistent package naming: @repo/{package-name}
         - Include proper TypeScript configuration
         - Set up proper build and test scripts
         - Document package purpose and usage
         - Use workspace:* for internal dependencies

examples:
  - input: |
      // Beach data processing in both apps
      interface Beach {
        name: string;
        location: string;
      }
    output: |
      // Create new package: @repo/beach-types
      // packages/beach-types/src/index.ts
      export interface Beach {
        name: string;
        location: string;
      }

  - input: |
      // Image processing logic duplicated
      const processImage = async (url: string) => {
        // Image processing logic
      }
    output: |
      // Create new package: @repo/image-utils
      // packages/image-utils/src/index.ts
      export const processImage = async (url: string) => {
        // Image processing logic
      }

metadata:
  priority: high
  version: 1.0
</rule>