description: 
globs: 
alwaysApply: true
---
  # ESLint Configuration Standards

<rule>
name: eslint_standards
description: Standards for ESLint configuration across the project
filters:
  - type: file_extension
    pattern: "\\.(js|ts|tsx)$"
  - type: file_name
    pattern: "^.eslintrc\\.(js|json)$"

actions:
  - type: suggest
    message: |
      When configuring ESLint:

      1. Project Type Detection:
         - For Next.js projects, use @repo/eslint-config/next-js
         - For all other projects, use @repo/eslint-config/base

      2. Base Configuration:
         ```javascript
         module.exports = {
           extends: ['@repo/eslint-config/base'],
           // Project-specific rules can be added here
         };
         ```

      3. Next.js Configuration:
         ```javascript
         module.exports = {
           extends: ['@repo/eslint-config/next-js'],
           // Project-specific rules can be added here
         };
         ```

      4. Package.json Dependencies:
         ```json
         {
           "devDependencies": {
             "@repo/eslint-config": "workspace:*",
             "eslint": "^9.22.0"
           }
         }
         ```

      5. Best Practices:
         - Always extend from the appropriate internal config
         - Keep ESLint in devDependencies only
         - Use workspace:* for internal package dependencies
         - Don't duplicate shared configurations
         - Add project-specific rules only when necessary
         - Use the latest version of ESLint and related plugins

      6. File Structure:
         ```
         PROJECT_ROOT/
         ├── .eslintrc.js
         └── package.json
         ```

examples:
  - input: |
      {
        "extends": ["eslint:recommended"]
      }
    output: |
      module.exports = {
        extends: ['@repo/eslint-config/base']
      };

  - input: |
      {
        "extends": ["eslint:recommended", "next"]
      }
    output: |
      module.exports = {
        extends: ['@repo/eslint-config/next-js']
      };

metadata:
  priority: high
  version: 1.0
</rule>