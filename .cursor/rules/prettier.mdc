 # Prettier Configuration Standards

<rule>
name: prettier_standards
description: Standards for Prettier configuration across the project
filters:
  - type: file_extension
    pattern: "\\.(js|ts|tsx|json|md)$"
  - type: file_name
    pattern: "^prettier\\.config\\.js$"

actions:
  - type: suggest
    message: |
      When configuring Prettier:

      1. Root Configuration:
         ```javascript
         /** @type {import("prettier").Config} */
         const config = {
           semi: true,
           singleQuote: true,
           tabWidth: 2,
           trailingComma: 'all',
         };

         module.exports = config;
         ```

      2. File Structure:
         ```
         PROJECT_ROOT/
         ├── prettier.config.js
         ├── .prettierignore
         └── package.json
         ```

      3. Ignore Patterns (.prettierignore):
         ```
         .next
         build
         coverage
         dist
         node_modules
         pnpm-lock.yaml
         .turbo
         .git
         ```

      4. Package.json Scripts:
         ```json
         {
           "scripts": {
             "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
             "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
           }
         }
         ```

      5. Best Practices:
         - Keep Prettier in root devDependencies only
         - Use consistent file extensions in glob patterns
         - Run formatting from root workspace
         - Use --check in CI/CD pipelines
         - Don't install Prettier in individual workspaces

examples:
  - input: |
      {
        "semi": false,
        "singleQuote": false,
        "tabWidth": 4
      }
    output: |
      /** @type {import("prettier").Config} */
      const config = {
        semi: true,
        singleQuote: true,
        tabWidth: 2,
        trailingComma: 'all',
      };

      module.exports = config;

  - input: |
      {
        "scripts": {
          "format": "prettier --write src/**/*.ts"
        }
      }
    output: |
      {
        "scripts": {
          "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
          "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\""
        }
      }

metadata:
  priority: high
  version: 1.0
</rule>