{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "crawler#start": {
      "cache": false,
      "persistent": true,
      "env": ["MAPS_API_KEY"]
    },
    "build": {
      "dependsOn": ["^build"]
    },
    "web#build": {
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "outputs": []
    },
    "check-types": {
      "outputs": [],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "crawler:dev": {
      "env": ["MAPS_API_KEY"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
