{
  "name": "playasmurcia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "download:playas-nexo-images": "tsx scripts/download-playas-nexo-images.ts",
    "score:picture-quality": "tsx scripts/score-beach-picture-quality.ts",
    "prune:small-pictures": "tsx scripts/prune-small-beach-pictures.ts",
    "fix:orthography": "node scripts/fix-orthography.js",
    "normalize:brightness": "tsx scripts/normalize-brightness.ts",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "sync:pictures": "sh scripts/sync-pictures-to-r2.sh",
    "build": "tsx scripts/generate-sitemap.ts && vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "format": "oxfmt \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.js\"",
    "check": "tsc --noEmit && oxlint src/ && oxfmt --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.js\""
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@libsql/client": "^0.18.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.2",
    "@tanstack/router-plugin": "^1.168.46",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@eslint-react/eslint-plugin": "^5.28.0",
    "@jmlweb/oxfmt-config-base": "^0.2.3",
    "@jmlweb/oxlint-config-react": "^0.1.2",
    "@jmlweb/vitest-config": "^3.0.2",
    "@tanstack/devtools-vite": "^0.8.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/leaflet.markercluster": "^1.5.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.8",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-perfectionist": "^5.12.1",
    "image-size": "^2.0.4",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "^1.64.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "web-vitals": "^6.2.3",
    "wrangler": "^4.151.1"
  }
}
