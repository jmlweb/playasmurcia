{
  "name": "playasmurcia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate:sitemap": "tsx scripts/generate-sitemap.ts",
    "download:playas-nexo-images": "tsx scripts/download-playas-nexo-images.ts",
    "score:picture-quality": "tsx scripts/score-beach-picture-quality.ts",
    "prune:small-pictures": "tsx scripts/prune-small-beach-pictures.ts",
    "fix:orthography": "node scripts/fix-orthography.js",
    "normalize:brightness": "tsx scripts/normalize-brightness.ts",
    "optimize:images": "tsx scripts/optimize-images.ts",
    "build": "tsx scripts/generate-sitemap.ts && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.js\"",
    "check": "tsc --noEmit && eslint src/ && prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.js\""
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@libsql/client": "^0.15.15",
    "@tailwindcss/vite": "^4.0.6",
    "@tanstack/react-devtools": "^0.7.0",
    "@tanstack/react-router": "^1.132.0",
    "@tanstack/react-router-devtools": "^1.132.0",
    "@tanstack/react-router-ssr-query": "^1.131.7",
    "@tanstack/react-start": "^1.132.0",
    "@tanstack/router-plugin": "^1.132.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.0.6",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.30.1",
    "@eslint/js": "^9.39.2",
    "@jmlweb/eslint-config-react": "^3.0.4",
    "@jmlweb/prettier-config-tailwind": "^1.0.6",
    "@jmlweb/vitest-config": "^2.0.0",
    "@tanstack/devtools-vite": "^0.3.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/sharp": "^0.32.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.0.16",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "image-size": "^2.0.2",
    "jsdom": "^27.0.0",
    "playwright": "^1.58.2",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.57.0",
    "vite": "^7.1.7",
    "vitest": "^4.0.16",
    "web-vitals": "^5.1.0"
  }
}
